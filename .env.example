# Copy to .env for local work. On Vercel, add these under Project Settings → Environment Variables.

# ── Database (pick one) ──
# Firebase Firestore (used first when all three are set)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# or LibSQL / Turso
DATABASE_URL=libsql://your-database-id.turso.io
DATABASE_AUTH_TOKEN=your-authentication-token

# ── Security ──
# Admin portal password. On the live site the old default password is refused, so this is required there.
ADMIN_PASSWORD=
# Optional, default "admin"
ADMIN_USERNAME=
# Signs login sessions. Any random text of 32+ characters.
SESSION_SECRET=

# ── Public address used in emails and payment redirects ──
APP_URL=https://solariq-public.vercel.app

# ── Payments (PayMongo) ──
PAYMONGO_SECRET_KEY=
# Secret shown when you create the webhook for /api/webhooks/paymongo (event: checkout_session.payment.paid)
PAYMONGO_WEBHOOK_SECRET=
# Optional, comma-separated; must match the methods enabled on your PayMongo account
PAYMONGO_METHODS=gcash,paymaya,card

# ── Email (any SMTP provider, e.g. Gmail with an app password) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── SMS (Semaphore) ──
SEMAPHORE_API_KEY=
# Optional, must be a sender name approved in your Semaphore account
SEMAPHORE_SENDER_NAME=

NODE_ENV=production
